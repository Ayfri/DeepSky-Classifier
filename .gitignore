# Python & Environments
__pycache__/
*.py[cod]
.venv/
.coverage

# Project Data & Artifacts
data/
# `models/*` plutôt que `models/` : même raison que pour reports/. Le rapport de recherche
# d'hyperparamètres est une preuve de C5.2.4, pas un artefact binaire regénérable à l'identique.
models/*
!models/hyperparam_results.json
# `reports/*` plutôt que `reports/` : git ne descend pas dans un répertoire exclu, donc une
# négation ne pourrait pas réintégrer un fichier. Le tableau de bord est un livrable, pas un artefact.
reports/*
!reports/dashboard.ipynb

