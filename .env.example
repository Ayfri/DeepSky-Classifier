# Copy to `.env` and fill in real values. Never commit `.env` (it is gitignored).
# All variables are read by `pydantic-settings` with the `DEEPSKY_` prefix (src/core/settings.py).

# --- Database ---
# Leave DB_HOST at its default (or unset) to fall back to a local SQLite file at data/deepsky.db.
DEEPSKY_DB_HOST=localhost
DEEPSKY_DB_PORT=5432
DEEPSKY_DB_NAME=deepsky
DEEPSKY_DB_USER=deepsky
DEEPSKY_DB_PASSWORD=deepsky

# --- Database roles (docker-compose.yml only, not read by pydantic-settings) ---
# `deepsky_admin` owns the schema and is the only role `migrate` connects as. `deepsky_app` is
# DML-only (SELECT/INSERT/UPDATE/DELETE, no CREATE/DROP) and is what `api`/`pipeline` connect as;
# see docker/postgres/init-app-role.sh.
DEEPSKY_DB_ADMIN_USER=deepsky_admin
DEEPSKY_DB_ADMIN_PASSWORD=deepsky_admin
DEEPSKY_DB_APP_USER=deepsky_app
DEEPSKY_DB_APP_PASSWORD=deepsky_app

# --- Model artefacts ---
DEEPSKY_MODEL_DIR=models

# --- Gaia archive (optional) ---
# Raises the anonymous TAP upload quota. Leave both empty to query as an anonymous user.
DEEPSKY_GAIA_USERNAME=
DEEPSKY_GAIA_PASSWORD=

# --- API ---
DEEPSKY_API_HOST=0.0.0.0
DEEPSKY_API_PORT=8000
DEEPSKY_API_WORKERS=1
